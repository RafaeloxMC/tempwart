{
	"name": "tempwart",
	"private": true,
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.1",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"web-ext": "^10.5.0"
	},
	"scripts": {
		"typecheck": "bunx tsc -p tsconfig.json --noEmit",
		"build": "bunx tsc -p tsconfig.build.json && bun scripts/copy-static.mjs",
		"watch:ts": "bunx tsc -p tsconfig.build.json --watch --preserveWatchOutput",
		"watch:static": "bun scripts/copy-static.mjs --watch",
		"watch:webext": "web-ext run --source-dir src",
		"dev": "bun scripts/dev.mjs"
	}
}
