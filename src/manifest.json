{
	"manifest_version": 3,
	"name": "TempWart",
	"description": "An email alias generator for self-hosted email servers using Stalwart.",
	"version": "0.0.1",
	"icons": {
		"64": "icons/icon.png"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "@tempwart",
			"data_collection_permissions": {
				"required": ["none"]
			},
			"strict_min_version": "58.0"
		}
	},
	"permissions": ["storage"],
	"host_permissions": ["<all_urls>"],
	"content_scripts": [
		{
			"matches": ["*://*.mozilla.org/*"],
			"js": ["content_script.js"]
		}
	],
	"action": {
		"default_icon": {
			"64": "icons/icon.png"
		},
		"default_popup": "popup/index.html",
		"default_title": "TempWart"
	},
	"options_ui": {
		"page": "options/index.html"
	}
}
